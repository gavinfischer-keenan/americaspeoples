{
  "name": "americas-peoples",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "node --import tsx scripts/build.ts",
    "test:browser": "node scripts/hosted-browser.mjs",
    "validate": "node --import tsx scripts/validate.ts",
    "preview": "node scripts/preview.mjs",
    "test:hosted": "node scripts/hosted-browser.mjs",
    "test:api": "python server/test_api.py",
    "verify:release": "node scripts/verify-release.mjs",
    "benchmark": "node --import tsx scripts/benchmark-scalability.ts"
  },
  "dependencies": {
    "d3-geo": "3.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.0",
    "@types/node": "24.0.0",
    "esbuild": "0.25.5",
    "fflate": "0.8.3",
    "marked": "15.0.12",
    "playwright": "1.56.1",
    "prettier": "3.5.3",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
